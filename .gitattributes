# Normalize line endings: LF in the repo, native on checkout.
# Stops every file showing as modified when the checkout is read from a
# different OS (e.g. the laptop's OneDrive checkout mounted into Linux).
* text=auto

# Windows-only scripts: keep CRLF on checkout everywhere.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Scripts that run inside the Linux container image: always LF, even in a Windows checkout
# (bash would read a CR as part of each line).
*.sh text eol=lf
container/Dockerfile text eol=lf

# Binaries
*.exe binary
*.png binary
*.jpg binary
